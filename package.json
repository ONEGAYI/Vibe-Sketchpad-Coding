{
	"name": "obsidian-html-latex-fix",
	"version": "0.1.0",
	"description": "Fix LaTeX rendering inside HTML tags in Obsidian's Reading View.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint ."
	},
	"keywords": ["obsidian", "plugin", "latex", "math", "html"],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.0",
		"tslib": "^2.8.0",
		"typescript": "^5.8.0"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
